# POLYBOT infrastructure & secrets. Copy to .env. NEVER commit .env.
#
# The bot reads this file from the project root. Keep production credentials
# outside source control and restrict file permissions to the operator account.
#
# What PAPER mode needs:
#   1. Dashboard login      REQUIRED  python -m btc5m_bot hash-password
#   2. CLOB API credentials REQUIRED  to verify the Chainlink oracle (see below).
#                                     Without them the oracle stays UNVERIFIED and
#                                     the bot records NO TRADE.
# Everything else is optional and already has a safe default.
#
# Secrets are COMMENTED OUT on purpose. Uncomment a line only when you give it a
# real value. Do not leave an empty "KEY=" line and do not define a key twice:
# the last definition wins, so an empty line below your real value would erase it.

# --- Dashboard (loopback only) ---
POLYBOT_HOST=127.0.0.1
POLYBOT_PORT=8765
POLYBOT_DASHBOARD_USERNAME=admin
POLYBOT_ALLOW_INSECURE_DASHBOARD=false

# Dashboard credentials (REQUIRED). Run:
#   python -m btc5m_bot hash-password
# and paste the two lines it prints here, replacing these two comments:
#   POLYBOT_DASHBOARD_PASSWORD_HASH=...
#   POLYBOT_SESSION_SECRET=...

# --- Public health listener (Render / UptimeRobot) ---
# A tiny separate listener serving /healthz (liveness) and /health (readiness). It returns status
# codes and short reason codes only: no trading state, no secrets. The dashboard above stays
# loopback-only. Off by default. On Render it turns itself on (Render injects PORT). Anywhere
# else, opt in by choosing a port (must differ from POLYBOT_PORT):
# POLYBOT_HEALTH_PORT=8080
# POLYBOT_HEALTH_HOST=0.0.0.0
# /health reports not-ready when the engine's liveness lease is older than this many seconds:
# POLYBOT_HEALTH_MAX_LEASE_AGE_SECONDS=60
# Serve the password-protected dashboard through that public port (proxied to the loopback
# dashboard). Automatic on Render when POLYBOT_DASHBOARD_PASSWORD_HASH is set; true/false forces it.
# POLYBOT_PUBLIC_DASHBOARD=true

# --- Exchange credentials ---
# Use a dedicated wallet/API key exclusively for POLYBOT: heartbeat expiry cancels
# orders for the whole API key, and no other software may share that key.
#
# CLOB API credentials (REQUIRED, even in PAPER). The Chainlink TWAP oracle that
# Polymarket resolves on authenticates through PolyBolt with all three values.
# They are not derived from the private key.
# POLYBOT_CLOB_API_KEY=
# POLYBOT_CLOB_API_SECRET=
# POLYBOT_CLOB_API_PASSPHRASE=
#
# Wallet: only needed for authenticated exchange access and LIVE trading.
# POLYBOT_PRIVATE_KEY=
# POLYBOT_FUNDER_ADDRESS=
POLYBOT_SIGNATURE_TYPE=0

# --- Heartbeat (LIVE only; disabled by default) ---
# WARNING: the first accepted heartbeat permanently arms a key-wide
# cancel-all-on-timeout on Polymarket. There is no disarm endpoint.
# Do not enable or test this during development. LIVE activation requires it.
POLYBOT_HEARTBEAT_ENABLED=false
POLYBOT_HEARTBEAT_DEDICATED_KEY_CONFIRMED=false
POLYBOT_HEARTBEAT_INTERVAL_SECONDS=5
POLYBOT_HEARTBEAT_LEASE_SECONDS=8
POLYBOT_SUPERVISOR_MAX_RESTARTS_PER_HOUR=5

# --- Endpoints (verified 2026-11-05) ---
POLYBOT_GAMMA_URL=https://gamma-api.polymarket.com
POLYBOT_CLOB_URL=https://clob.polymarket.com
POLYBOT_DATA_API_URL=https://data-api.polymarket.com
POLYBOT_POLYBOLT_URL=wss://ws-live-v2.polymarket.com/ws
POLYBOT_GEO_URL=https://polymarket.com/api/geoblock

# --- BTC spot feeds (used by the engine's signal; the dashboard shows Chainlink only) ---
POLYBOT_BINANCE_WS=wss://stream.binance.com:9443/ws/btcusdt@trade
POLYBOT_COINBASE_WS=wss://ws-feed.exchange.coinbase.com

# --- Persistent defaults (survive restarts on hosts without a disk, e.g. Render free) ---
# Applied on every start so capital / rule approval do not have to be set again by hand.
# Allocated capital, used only while runtime.json has no capital_usd:
# POLYBOT_DEFAULT_CAPITAL_USD=1000
# Rule fingerprints approved automatically (comma separated, any mode):
# POLYBOT_APPROVED_RULE_FINGERPRINTS=
# Approve every resolution rule automatically. PAPER mode only, never applied in LIVE:
# POLYBOT_AUTO_APPROVE_RULES=true

# --- Optional overrides (leave commented to keep the defaults) ---
# Dashboard session lifetime in seconds (default 28800 = 8 h):
# POLYBOT_SESSION_MAX_AGE_SECONDS=28800
# Folders (defaults: <project>\data, <project>\logs, <project>\config):
# POLYBOT_DATA_DIR=
# POLYBOT_LOGS_DIR=
# POLYBOT_CONFIG_DIR=
# File names (defaults: polybot.db, parquet, polybot.lock):
# POLYBOT_DB_FILENAME=polybot.db
# POLYBOT_PARQUET_DIRNAME=parquet
# POLYBOT_SINGLE_INSTANCE_LOCK=polybot.lock
